    "@types/node": "^18.11.17",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "axios": "^1.2.0",
    "bootstrap": "^5.2.3",
    "buffer": "^6.0.3",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "front-matter": "^4.0.2",
    "markdown-to-text": "^0.1.1",
    "prettier": "^2.8.1",
